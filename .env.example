# Copiá este archivo a ".env" (local) o cargá estas variables en Vercel
# (Project → Settings → Environment Variables).

# Puerto del servidor local (opcional, default 3000). No aplica en Vercel.
PORT=3000

# --- Ingreso (un solo usuario) ---
# Usuario (default "kasa") y contraseña. En Vercel APP_CLAVE es obligatoria.
# En local, si APP_CLAVE queda vacía, se entra con cualquier clave.
APP_USUARIO=kasa
APP_CLAVE=
# Secreto para firmar la cookie de sesión (obligatorio en Vercel; el repo es público).
# Cualquier texto largo al azar. Cambiarlo cierra todas las sesiones.
SESSION_SECRET=

# --- Datos en Google Sheets ---
# Si GOOGLE_SHEET_ID queda vacío, los datos van a data/kasa.json (solo local).
# Id de la planilla: lo que va entre /d/ y /edit en su URL.
GOOGLE_SHEET_ID=
# JSON completo de la clave de la cuenta de servicio, en una sola línea.
# La planilla tiene que estar compartida como Editor con su "client_email".
GOOGLE_SERVICE_ACCOUNT_JSON=
